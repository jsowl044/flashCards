rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user may only touch their own document, and it must keep the
    // exact shape the app writes — this keeps a stranger who signs in from storing
    // arbitrary data (or large amounts of it) in the project.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['decks', 'updatedAt'])
        && request.resource.data.decks is list
        && request.resource.data.decks.size() <= 200
        && request.resource.data.updatedAt is number;
    }
  }
}
